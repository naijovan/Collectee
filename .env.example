# ─────────────────────────────────────────────────────────────────────────────
# Collectee — environment
#
# Copy this file to `.env` and fill it in. `.env` is gitignored; this file is
# not, so never put a real key here.
#
#   cp .env.example .env
#
# Restart the dev server after editing — Expo reads env at bundle time, so a
# running server will not pick up a change.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI assistant ─────────────────────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/apikey  ("Create API key")
# The free tier is enough for the demo.
#
# Leave BLANK to keep the assistant fully mocked and offline — it still answers
# every question about your own inventory, collections, showrooms and followers,
# because those are computed locally. The key only adds free-form questions.
#
# ⚠️ EXPO_PUBLIC_* values are bundled into the shipped JavaScript and readable
# by anyone with the app. Fine for a free-tier hackathon key; the exposure is
# quota. Do not use a billed key here — use ASSISTANT_PROXY_URL instead.
EXPO_PUBLIC_GEMINI_API_KEY=

# Which model to call. Availability and quota vary by key — if the assistant
# reports 404 or "out of quota", try another name from
# https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# ── Optional: proxy mode ─────────────────────────────────────────────────────
# If set, the app calls this endpoint instead of Gemini directly and the key
# lives on your server. Takes precedence over the key above. This is the only
# configuration that actually protects a key.
EXPO_PUBLIC_ASSISTANT_PROXY_URL=

# Optional header so the proxy can distinguish your app from casual traffic.
# Not authentication — it ships in the bundle like everything else.
EXPO_PUBLIC_ASSISTANT_CLIENT_TAG=

# ── News AI (J5 — PRD §12.1's "one real model call") ─────────────────────────
# The URL of the deployed /api/summarise function, e.g.
#   https://collectee-summariser.vercel.app/api/summarise
#
# ONE endpoint serves both capabilities — article summaries and the per-game
# trends digest — so this is the only URL to configure.
#
# Leave BLANK and the article screen keeps its prepared summaries and the news
# screen its prepared digests, both with the honest "no model call runs in this
# build" label. Setting it is only half the switch — FEATURES.liveSummarisation
# must also be true (src/config/features.ts).
EXPO_PUBLIC_SUMMARY_PROXY_URL=

# ⚠️ THE ANTHROPIC KEY DOES NOT GO IN THIS FILE.
#
# It is billed, and every EXPO_PUBLIC_* value is bundled into the shipped
# JavaScript where anyone with the app can read it. The key belongs in Vercel's
# environment variables for the deployed function, under the name
# ANTHROPIC_API_KEY — set via `vercel env add ANTHROPIC_API_KEY` or the
# project's Settings → Environment Variables page. It is never read by the app.
