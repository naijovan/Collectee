# ─────────────────────────────────────────────────────────────────────────────
# Collectee — environment
#
# Copy this file to `.env` and fill it in. `.env` is gitignored; this file is
# not, so never put a real key here.
#
#   cp .env.example .env
#
# Restart the dev server after editing — Expo reads env at bundle time, so a
# running server will not pick up a change.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI assistant ─────────────────────────────────────────────────────────────
# Google AI Studio key: https://aistudio.google.com/apikey  ("Create API key")
# The free tier is enough for the demo.
#
# Leave BLANK to keep the assistant fully mocked and offline — it still answers
# every question about your own inventory, collections, showrooms and followers,
# because those are computed locally. The key only adds free-form questions.
#
# ⚠️ EXPO_PUBLIC_* values are bundled into the shipped JavaScript and readable
# by anyone with the app. Fine for a free-tier hackathon key; the exposure is
# quota. Do not use a billed key here — use ASSISTANT_PROXY_URL instead.
EXPO_PUBLIC_GEMINI_API_KEY=

# ── Optional: proxy mode ─────────────────────────────────────────────────────
# If set, the app calls this endpoint instead of Gemini directly and the key
# lives on your server. Takes precedence over the key above. This is the only
# configuration that actually protects a key.
EXPO_PUBLIC_ASSISTANT_PROXY_URL=

# Optional header so the proxy can distinguish your app from casual traffic.
# Not authentication — it ships in the bundle like everything else.
EXPO_PUBLIC_ASSISTANT_CLIENT_TAG=
