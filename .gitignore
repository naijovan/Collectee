# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# ALL of them, not just *.local — a plain `.env` holding a proxy secret was
# committable before this line existed.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# Art-pack source material — raw generator dumps and vendor packs, ~90MB.
# Working input only: the renders the app actually bundles are copied into
# assets/collectee/ under their catalogue-item ids and ARE tracked. Keeping the
# sources out means assets/ contains exactly what ships and nothing else.
art-source/

# Same reasoning for the app-ready delivery: its PNGs are copied verbatim into
# assets/collectee/{subjects,items}/ and tracked there, so keeping the originals
# too would double the repo's art weight for no benefit. The pack's docs and
# manifest ARE tracked — they are the provenance record for who each render is.
assets/collectee/collectee-app-ready/images/

# generated native folders
/ios
/android

# Vercel CLI: the linked-project id and its downloaded OIDC token.
# `vercel link` also appended a broad `.env*` here, which was removed — it sat
# BELOW the `!.env.example` negation above and therefore cancelled it, quietly
# ignoring the one env file that is meant to be committed. The rules at the top
# of this file already cover `.env` and `.env.*`.
.vercel

# Local Claude Code settings, including the "settings.local 2.json" duplicates
# cloud sync leaves behind — same class of stray file the fixture validator
# rejects (see 5d414d8).
.claude/

# Local working area. Never shipped, never reviewed, never committed.
#
# `scratchpad/refs/` holds REFERENCE IMAGERY handed to the art agent — third-party
# character art we do not own and must not redistribute. The art we ship is
# original prototype work (§15, and the header of `config/avatarRoster.ts`); a
# reference that reached a commit would put someone else's asset in our history
# permanently, which no later deletion undoes.
#
# This line stops an accidental `git add -A`. It does NOT stop `git add -f` —
# the pre-commit hook in `.git/hooks/pre-commit` is what covers that, and hooks
# are local, so anyone cloning this repo needs their own copy.
scratchpad/

# Display-art bake INPUTS (~29MB). `scripts/bake-display-art.ts` reads these to
# produce assets/collectee/display/, which IS committed because the app
# requires it at build time. The inputs are not needed to run or ship the app,
# and re-baking is a local step.
assets/collectee/display-sources/

# Demo upload set — copies of catalogue renders, named for a file picker.
# 51MB that already exists one directory over in assets/collectee/, so it is
# generated rather than committed. Rebuild with `npm run build:demo`.
demo/
